# StayOps uses the deterministic synthesizer unless explicitly changed.
SYNTHESIZER_MODE=deterministic

# LLM experiment settings (required only when SYNTHESIZER_MODE=llm).
LLM_PROVIDER=nebius
LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
LLM_SYNTHESIZER_FALLBACK=deterministic
LLM_TIMEOUT_SECONDS=60

# Nebius Token Factory (OpenAI-compatible, but no OpenAI key is required).
# NEBIUS_API_KEY=<nebius-api-key>
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Local Ollama alternative.
LLM_PROVIDER=ollama
LLM_MODEL=mistral:latest
OLLAMA_BASE_URL=http://localhost:11434

# Optional ElevenLabs push-to-talk interface for Ask StayOps only.
VOICE_ENABLED=false
# ELEVENLABS_API_KEY=<restricted-elevenlabs-api-key>
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_VOICE_ID=<elevenlabs-voice-id>
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_LANGUAGE_CODE=eng
VOICE_MAX_SECONDS=30
VOICE_MAX_AUDIO_BYTES=10000000
